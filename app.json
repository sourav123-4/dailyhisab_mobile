{
  "expo": {
    "name": "DailyPulse AI",
    "slug": "dailyhisab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dailyhisab",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#080B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyhisab.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DailyHisab uses microphone for voice-assisted hisab financial entries and workout logging."
      }
    },
    "android": {
      "package": "com.dailyhisab.mobile",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#080B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#080B12"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-audio",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "TitanFit needs access to your photo library to select food and meal photos for macro calculation.",
          "cameraPermission": "TitanFit needs access to your camera to take photos of your meals to calculate calories, protein, carbs and fats."
        }
      ]
    ]
  }
}
