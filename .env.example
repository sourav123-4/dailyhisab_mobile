# App config. Only NON-secret values belong here: Expo inlines every EXPO_PUBLIC_*
# value into the app bundle. Never put API keys or client secrets in this file.
# Firebase and Google Sign-In config is read from google-services.json.
# AI provider keys are stored server-side in the ai-proxy/ Cloudflare Worker.

EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
EXPO_PUBLIC_GROQ_STT_MODEL=whisper-large-v3

# Free Cloudflare Worker proxy URL printed by `npx wrangler deploy` (see ai-proxy/README.md)
EXPO_PUBLIC_AI_PROXY_URL=https://dailyhisab-ai-proxy.<your-subdomain>.workers.dev
